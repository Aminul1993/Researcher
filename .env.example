# Copy this file to .env and fill in your API key.

# Groq — create an API key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com

# Optional server settings (defaults shown)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=false
# LOG_LEVEL=INFO
# Reverse proxies in front of the app whose X-Forwarded-* headers to trust.
# TRUSTED_PROXIES=0

# Login and limits. Set APP_PASSWORD before exposing the server beyond
# localhost: every run uses your Groq key. Login is off while it is empty.
# APP_USERNAME=admin
# APP_PASSWORD=
# MAX_CONCURRENT_RUNS=4
# RUN_TIME_BUDGET_SECONDS=600

# Per-role models (defaults shown; all Groq production models as of
# 2026-11-10). Uncomment to override. Any refused or rate-limited model
# falls back to GROQ_MODEL.
# GROQ_MODEL_SUPERVISOR=openai/gpt-oss-20b
# GROQ_MODEL_DESIGNER=openai/gpt-oss-120b
# GROQ_MODEL_FINALIZER=openai/gpt-oss-120b
# GROQ_MODEL_PLANNING=llama-3.3-70b-versatile
# GROQ_MODEL_RESEARCH=llama-3.3-70b-versatile
# GROQ_MODEL_CODING=openai/gpt-oss-120b
# GROQ_MODEL_REVIEW=llama-3.3-70b-versatile
# GROQ_MODEL_ANALYSIS=openai/gpt-oss-120b
# GROQ_MODEL_WRITING=llama-3.3-70b-versatile
