# Copy this file to .env and fill in your API key.

# Ollama Cloud — create an API key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# Optional server settings (defaults shown)
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
# FLASK_DEBUG=false
# LOG_LEVEL=INFO
# Reverse proxies in front of the app whose X-Forwarded-* headers to trust.
# TRUSTED_PROXIES=0

# Login and limits. Set APP_PASSWORD before exposing the server beyond
# localhost: every run spends your Ollama key. Login is off while it is empty.
# APP_USERNAME=admin
# APP_PASSWORD=
# MAX_CONCURRENT_RUNS=4
# RUN_TIME_BUDGET_SECONDS=600

# Per-role models (defaults shown; all on the Ollama Cloud Free plan as of
# 2026-10-13). Uncomment to override. Any refused model falls back to
# OLLAMA_MODEL.
# OLLAMA_MODEL_SUPERVISOR=gemma4:31b
# OLLAMA_MODEL_DESIGNER=gpt-oss:120b
# OLLAMA_MODEL_FINALIZER=gpt-oss:120b
# OLLAMA_MODEL_PLANNING=nemotron-3-super
# OLLAMA_MODEL_RESEARCH=nemotron-3-ultra
# OLLAMA_MODEL_CODING=gpt-oss:120b
# OLLAMA_MODEL_REVIEW=nemotron-3-ultra
# OLLAMA_MODEL_ANALYSIS=gpt-oss:120b
# OLLAMA_MODEL_WRITING=gemma4:31b
